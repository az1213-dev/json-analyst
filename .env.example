# ==============================================================================
# JSON Analyst Environment Configuration
# ==============================================================================
#
# Copy this file to .env and fill in the actual values for your environment.
#
# This file is tracked in git as a template to show what variables are needed.
# ==============================================================================

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Application environment: development, staging, production
NODE_ENV=development

# Application port (for preview server)
PORT=3000

# Application URL for CORS and redirects
APP_URL=http://localhost:3000

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Enable verbose logging
DEBUG=false

# Enable development mode features
DEVELOPMENT_MODE=false

# ==============================================================================
# EXTERNAL SERVICES (if needed in future)
# ==============================================================================

# Analytics (e.g., Google Analytics ID)
# ANALYTICS_ID=

# Error tracking (e.g., Sentry DSN)
# SENTRY_DSN=

# GitHub API (if you add features that need it)
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# ==============================================================================
# SECURITY
# ==============================================================================

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000

# Rate limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# DATABASE (if you add backend in future)
# ==============================================================================

# Database connection string
# DATABASE_URL=

# Database credentials
# DB_USER=
# DB_PASSWORD=

# ==============================================================================
# CACHE & STORAGE
# ==============================================================================

# Cache TTL in seconds
# CACHE_TTL=3600

# File upload directory
# UPLOAD_DIR=./uploads

# ==============================================================================
# THIRD-PARTY SERVICES
# ==============================================================================

# Email service (if you add email features)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ==============================================================================
# IMPORTANT SECURITY NOTES
# ==============================================================================
#
# 1. NEVER commit real credentials to version control
# 2. Use .env.example as a template showing which variables are needed
# 3. Keep .env in .gitignore to prevent accidental commits
# 4. Use a secrets manager in production (e.g., AWS Secrets Manager, HashiCorp Vault)
# 5. Rotate keys and credentials regularly
# 6. Never log sensitive information
# 7. Use HTTPS in production
# 8. Keep dependencies updated
# 9. Run security audits regularly: npm audit
# 10. Follow principle of least privilege for API keys and database access
#
# ==============================================================================
